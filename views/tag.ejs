<%- include('partials/header') %>

<div class="feed-header">
  <h1>#<%= tag %></h1>
  <a href="/tags" class="btn btn-solid">All tags</a>
</div>

<% if (posts.length === 0) { %>
  <div class="empty">No posts with this tag yet.</div>
<% } else { %>
  <div class="feed">
    <% posts.forEach(function (post) { %>
      <%- include('partials/post-card', { post: post }) %>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>