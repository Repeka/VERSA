<%- include('partials/header') %>

<div class="home-layout">
  <div class="home-main">
    <div class="feed-header">
      <h1>Fresh on VERSA</h1>
      <a href="/posts/new" class="btn btn-solid">+ New post</a>
    </div>

    <div class="filter-tabs">
      <a href="/" class="<%= (type === 'all' && !following) ? 'active' : '' %>">All</a>
      <a href="/?feed=following" class="<%= following ? 'active' : '' %>">Following</a>
      <a href="/?type=question" class="<%= type === 'question' ? 'active' : '' %>">Questions</a>
      <a href="/?type=artwork" class="<%= type === 'artwork' ? 'active' : '' %>">Artwork</a>
      <a href="/?type=poem" class="<%= type === 'poem' ? 'active' : '' %>">Poems</a>
    </div>

    <% if (popularTags.length > 0) { %>
      <div class="tag-strip">
        <span class="post-date">Popular tags:</span>
        <% popularTags.forEach(function (t) { %>
          <a href="/tags/<%= encodeURIComponent(t.tag) %>" class="tag">#<%= t.tag %></a>
        <% }) %>
        <a href="/tags" class="tag tag-more">All tags →</a>
      </div>
    <% } %>

    <% if (posts.length === 0) { %>
      <div class="empty">
        <%= following ? 'Nothing from people you follow yet. Visit a profile and press Follow!' : 'Nothing here yet. Be the first to share something!' %>
      </div>

    <% } else if (type === 'artwork' && !following) { %>
      <div class="gallery">
        <% posts.forEach(function (post) { %>
          <a class="gallery-item" href="/posts/<%= post.id %>">
            <div class="gallery-img"><img src="<%= post.image %>" alt="<%= post.title %>" loading="lazy"></div>
            <div class="gallery-caption">
              <strong><%= post.title %></strong>
              <span>@<%= post.username %> · ▲ <%= post.score || 0 %></span>
            </div>
          </a>
        <% }) %>
      </div>

    <% } else { %>
      <div class="feed">
        <% posts.forEach(function (post) { %>
          <%- include('partials/post-card', { post: post, showHide: true }) %>
        <% }) %>
      </div>
    <% } %>
  </div>

  <aside class="home-side">
    <% if (openChallenges.length > 0) { %>
      <section class="side-card">
        <h3>🎨 Open challenges</h3>
        <ul class="side-list">
          <% openChallenges.forEach(function (c) { %>
            <li class="side-challenge">
              <a href="/challenges/<%= c.id %>"><%= c.title %></a>
              <span class="post-date">Closes <span class="local-time" data-iso="<%= c.deadline %>"><%= c.deadline %></span></span>
            </li>
          <% }) %>
        </ul>
      </section>
    <% } %>

    <% if (suggestedMembers.length > 0) { %>
      <section class="side-card">
        <h3>Who to follow</h3>
        <ul class="side-list">
          <% suggestedMembers.forEach(function (m) { %>
            <li>
              <% if (m.avatar) { %>
                <img class="avatar avatar-small" src="<%= m.avatar %>" alt="">
              <% } else { %>
                <div class="avatar avatar-small avatar-letter"><%= m.username.charAt(0).toUpperCase() %></div>
              <% } %>
              <a class="side-name" href="/u/<%= m.username %>"><%= m.display_name || m.username %></a>
              <form action="/u/<%= m.username %>/follow" method="POST">
                <input type="hidden" name="back" value="/">
                <button type="submit" class="side-follow">Follow</button>
              </form>
            </li>
          <% }) %>
        </ul>
      </section>
    <% } %>
  </aside>
</div>

<%- include('partials/footer') %>