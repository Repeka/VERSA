<article class="feed-card feed-<%= post.type %>">
    <% if (post.reposted_by) { %>
    <p class="repost-label">🔁 @<%= post.reposted_by %> reposted</p>
  <% } %>
  <div class="feed-top">
    <span class="badge badge-<%= post.type %>"><%= post.type %></span>
    <span class="post-date">▲ <%= post.score || 0 %> · 💬 <%= post.comment_count || 0 %> · <%= post.created_at.slice(0, 10) %></span>
  </div>

  <h2><a href="/posts/<%= post.id %>"><%= post.title %></a></h2>
    <% const cardTags = tagsFor(post.id); %>
  <% if (cardTags.length > 0) { %>
    <div class="tag-list">
      <% cardTags.forEach(function (t) { %>
        <a href="/tags/<%= encodeURIComponent(t) %>" class="tag">#<%= t %></a>
      <% }) %>
    </div>
  <% } %>

  <% if (post.type === 'artwork') { %>
    <a href="/posts/<%= post.id %>">
      <img class="feed-image" src="<%= post.image %>" alt="<%= post.title %>">
    </a>
  <% } %>

  <% if (post.body) { %>
    <p class="feed-preview <%= post.type === 'poem' ? 'poem' : '' %>"><%= post.body.length > 220 ? post.body.slice(0, 220) + '…' : post.body %></p>
  <% } %>

  <div class="post-author">
    <% if (post.avatar) { %>
      <img class="avatar avatar-small" src="<%= post.avatar %>" alt="">
    <% } else { %>
      <div class="avatar avatar-small avatar-letter"><%= post.username.charAt(0).toUpperCase() %></div>
    <% } %>
    <a href="/u/<%= post.username %>"><%= post.display_name || post.username %></a>
  </div>
    <% if (locals.showHide && post.username !== currentUser.username) { %>
    <form action="/posts/<%= post.id %>/interest" method="POST" class="feed-hide">
      <input type="hidden" name="value" value="no">
      <input type="hidden" name="next" value="feed">
      <button type="submit">🙈 Not interested</button>
    </form>
  <% } %>
</article>